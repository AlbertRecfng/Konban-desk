# Строка подключения: postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kanban

# Секрет для подписи access-токенов (любая длинная случайная строка)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string

PORT=4000
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
